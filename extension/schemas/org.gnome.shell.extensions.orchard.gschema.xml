<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.orchard" path="/org/gnome/shell/extensions/orchard/">
    <key name="push-to-talk" type="as">
      <default>['Print']</default>
      <summary>Hold to speak to Orchard</summary>
    </key>
    <key name="speak-next" type="as">
      <default>['&lt;Ctrl&gt;&lt;Alt&gt;&lt;Shift&gt;space']</default>
      <summary>Speak the oldest queued agent result</summary>
    </key>
    <key name="auto-speak" type="b">
      <default>false</default>
      <summary>Automatically speak completed agent results</summary>
    </key>
  </schema>
</schemalist>
