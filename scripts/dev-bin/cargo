#!/usr/bin/env bash
set -euo pipefail

real_cargo=${ORCHRD_REAL_CARGO:?Use this wrapper from the orchrd Nix development shell}

if [[ ${ORCHRD_SKIP_CALLGRAPH:-} == 1 ]]; then
    exec "$real_cargo" "$@"
fi

command_name=${1:-}
if [[ $command_name == +* ]]; then
    command_name=${2:-}
fi

case "$command_name" in
    build|check|run|test|bench|clippy) ;;
    *) exec "$real_cargo" "$@" ;;
esac

if [[ $PWD != "$ORCHRD_WORKTREE_ROOT" && $PWD != "$ORCHRD_WORKTREE_ROOT/"* ]]; then
    exec "$real_cargo" "$@"
fi

if [[ $command_name == run || $command_name == bench ]]; then
    python3 "$ORCHRD_WORKTREE_ROOT/scripts/regenerate_call_graph.py"
    exec "$real_cargo" "$@"
fi

"$real_cargo" "$@"
python3 "$ORCHRD_WORKTREE_ROOT/scripts/regenerate_call_graph.py"
